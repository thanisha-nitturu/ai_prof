# Apache rewrite rules for local_portfolio plugin.
# This file is processed AFTER the VirtualHost rules (AllowOverride All is set).
#
# PURPOSE:
#   Map clean public share URLs of the form:
#     https://site/local/portfolio/p/{slug}
#   to view.php without exposing the PHP filename in the browser address bar.
#
# SECURITY:
#   - Only alphanumeric-and-hyphen slugs are matched (strict regex).
#   - Requests that don't match the pattern fall through normally.
#   - view.php itself is protected by NO_MOODLE_COOKIES and emits no session.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /local/portfolio/

  # Route /local/portfolio/p/{slug} → view.php (slug is validated by regex)
  # Allowed slug characters: letters, digits, hyphens, underscores (max 80 chars)
  RewriteRule ^p/([A-Za-z0-9][A-Za-z0-9_-]{1,78}[A-Za-z0-9_-])$ view.php [L,QSA]
</IfModule>
