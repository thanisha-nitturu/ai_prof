{{!
    @template theme_moove/footer

    Page footer.

    Example context (json):
    {
        "output": {
            "page_doc_link": "Help and documentation",
            "supportemail": "<a href=\"#\">Contact site support</a>",
            "has_popover_links": true,
            "services_support": "Services and support",
            "login_info": "You are logged in as cute kitten",
            "moodle_release": "90210"
        }
    }
}}

<footer id="page-footer">
    <div class="moove-container-fluid footer-columns">
        <div class="row">
            <div class="col-md-4 column-left">
                <div class="contact">
                    <h3 class="footer-title">{{#str}}contactus, theme_moove{{/str}}</h3>

                    <ul>
                        {{#website}}
                            <li>
                                <a href="{{{website}}}" target="_blank" class="website btn btn-link">
                                    <i class="fa fa-globe"></i>
                                </a>
                            </li>
                        {{/website}}
                        {{#mobile}}
                            <li>
                                <a href="tel:{{{mobile}}}" target="_blank" class="mobile btn btn-link">
                                    <i class="fa fa-phone"></i>
                                </a>
                            </li>
                        {{/mobile}}
                        {{#mail}}
                            <li>
                                <a href="mailto:{{{mail}}}" target="_blank" class="mail btn btn-link">
                                    <i class="fa fa-envelope"></i>
                                </a>
                            </li>
                        {{/mail}}
                    </ul>
                </div>

                <div class="socialnetworks">
                    <h3 class="footer-title">{{#str}}followus, theme_moove{{/str}}</h3>

                    <ul class="mb-0">
                        {{#facebook}}
                            <li>
                                <a href="{{{facebook}}}" target="_blank" class="facebook btn btn-link btn-rounded">
                                    <i class="fa fa-facebook"></i>
                                </a>
                            </li>
                        {{/facebook}}

                        {{#twitter}}
                            <li>
                                <a href="{{{twitter}}}" target="_blank" class="twitter btn btn-link btn-rounded">
                                    <i class="fa fa-twitter"></i>
                                </a>
                            </li>
                        {{/twitter}}

                        {{#linkedin}}
                            <li>
                                <a href="{{{linkedin}}}" target="_blank" class="linkedin btn btn-link btn-rounded">
                                    <i class="fa fa-linkedin"></i>
                                </a>
                            </li>
                        {{/linkedin}}

                        {{#youtube}}
                            <li>
                                <a href="{{{youtube}}}" target="_blank" class="youtube btn btn-link btn-rounded">
                                    <i class="fa fa-youtube"></i>
                                </a>
                            </li>
                        {{/youtube}}

                        {{#instagram}}
                            <li>
                                <a href="{{{instagram}}}" target="_blank" class="instagram btn btn-link btn-rounded">
                                    <i class="fa fa-instagram"></i>
                                </a>
                            </li>
                        {{/instagram}}

                        {{#whatsapp}}
                            <li>
                                <a href="https://api.whatsapp.com/send?phone={{{whatsapp}}}" target="_blank" class="whatsapp btn btn-link btn-rounded">
                                <i class="fa fa-whatsapp"></i>
                                </a>
                            </li>
                        {{/whatsapp}}

                        {{#telegram}}
                            <li>
                                <a href="{{{telegram}}}" target="_blank" class="telegram btn btn-link btn-rounded">
                                    <i class="fa fa-telegram"></i>
                                </a>
                            </li>
                        {{/telegram}}
                    </ul>
                </div>
            </div>
            <div class="col-md-4 column-center">
                {{# output.supportemail }}
                    <div class="supportemail">{{{ output.supportemail }}}</div>
                {{/ output.supportemail }}

                {{{ output.login_info }}}


                <div class="tool_usertours-resettourcontainer"></div>
            </div>
            
        </div>
    </div>

    <div class="footer-content-debugging footer-dark bg-dark text-light">
        <div class="moove-container-fluid footer-dark-inner">
            {{{ output.debug_footer_html }}}
        </div>
    </div>

    
   

<!-- Persistent Audio Player -->
<div id="persistent-audio-player" style="display:none; position:fixed; bottom:0; left:0; right:0; background:#343a40; color:white; padding:10px; z-index:9999; border-top:2px solid #007bff;">
  <div style="display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; max-width:1200px; margin:0 auto; gap:16px;">
    
    <!-- Podcast Title EXTREME LEFT -->
    <div style="flex: 1; min-width: 200px; max-width: 350px;">
    <div id="track-title" style="line-height:1.2;">
        <span class="course-title">Ready to play podcast</span>
      </div>
    </div>

    <!-- Rewind / Prev / Play / Next / Forward Controls -->
    <div class="audio-controls-container" style="display:flex; align-items:center; gap:10px;">
      <!-- Skip Backward 10s -->
      <button id="skip-back" class="circle-btn">
        <!-- Rewind SVG -->
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 36 36" fill="none">
          <path d="M18 6V2L12 8l6 6V10c5 0 9 4 9 9s-4 9-9 9-9-4-9-9H6c0 6.63 5.37 12 12 12s12-5.37 12-12S24.63 6 18 6z" fill="white"/>
          <text x="13" y="24" font-size="10" fill="white" font-family="Arial" font-weight="bold">10</text>
        </svg>
      </button>

      <!-- Previous Podcast -->
      <button id="prev-podcast" class="circle-btn" title="Previous Podcast">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="white" viewBox="0 0 24 24">
          <path d="M6 12l8-6v12l-8-6zM4 6h2v12H4z"/>
        </svg>
      </button>

      <!-- Play / Pause -->
      <button id="play-pause-btn" style="width:48px; height:48px; border-radius:50%; background-color:#205eff; border:none; display:flex; align-items:center; justify-content:center; cursor:pointer;">
        <div id="play-pause-icon" class="pause-icon"></div>
      </button>

      <!-- Next Podcast -->
      <button id="next-podcast" class="circle-btn" title="Next Podcast">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="white" viewBox="0 0 24 24">
          <path d="M18 12l-8-6v12l8-6zM18 6h2v12h-2z"/>
        </svg>
      </button>

      <!-- Skip Forward 10s -->
      <button id="skip-forward" class="circle-btn">
        <!-- Forward SVG -->
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 36 36" fill="none">
          <path d="M18 6V2l6 6-6 6V10c-5 0-9 4-9 9s4 9 9 9 9-4 9-9h3c0 6.63-5.37 12-12 12S6 25.63 6 19s5.37-13 12-13z" fill="white"/>
          <text x="13" y="24" font-size="10" fill="white" font-family="Arial" font-weight="bold">10</text>
        </svg>
      </button>
    </div>


    <!-- Seekbar -->
    <div style="flex-grow:1; display:flex; align-items:center; min-width:200px;">
      <span id="current-time" style="font-size:12px; margin-right:10px;">0:00</span>
      <input id="seekbar" type="range" min="0" max="100" value="0" style="flex-grow:1; margin-right:10px; accent-color:#205eff;">
      <span id="total-time" style="font-size:12px;">0:00</span>
    </div>

    <!-- Volume / Speed / Close -->
    <div style="display:flex; align-items:center; gap:8px;">
      <!-- Inside your player UI -->
      <!-- Volume Mute -->
      <svg id="vol-mute" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
          width="24" height="24" style="min-width:24px; display:none;">
        <!-- Speaker base -->
        <path fill="white" d="M3 10v4h4l5 5V5L7 10H3z"/>
        
        <line x1="2" y1="6" x2="18" y2="16" stroke="#205eff" stroke-width="2"/>
      </svg>

      <!-- Volume Low -->
      <svg id="vol-low" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
          width="24" height="24" style="min-width:24px; display:none;">
        <path fill="white" d="M3 10v4h4l5 5V5L7 10H3z"/>
        <path fill="#205eff" d="M14.5 12c0-1.77-.73-3.37-1.9-4.53l-1.06 1.06a5.985 5.985 0 0 1 0 6.94l1.06 1.06c1.17-1.16 1.9-2.76 1.9-4.53z"/>
        
      </svg>

      <!-- Volume Medium -->
      <svg id="vol-medium" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
          width="24" height="24" style="min-width:24px; display:none;">
        <path fill="white" d="M3 10v4h4l5 5V5L7 10H3z"/>
        <path fill="#205eff" d="M14.5 12c0-1.77-.73-3.37-1.9-4.53l-1.06 1.06a5.985 5.985 0 0 1 0 6.94l1.06 1.06c1.17-1.16 1.9-2.76 1.9-4.53z"/>
        <path fill="#205eff" d="M15.8 12c0-2.1-.86-4.01-2.25-5.4l-0.9 0.9a6.985 6.985 0 0 1 0 8.99l0.9 0.9c1.39-1.39 2.25-3.3 2.25-5.39z"/>
      </svg>
      </svg>


      <!-- Volume High -->
      <svg id="vol-high" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
          width="24" height="24" style="min-width:24px;">
        <path fill="white" d="M3 10v4h4l5 5V5L7 10H3z"/>
        <path fill="#205eff" d="M14.5 12c0-1.77-.73-3.37-1.9-4.53l-1.06 1.06a5.985 5.985 0 0 1 0 6.94l1.06 1.06c1.17-1.16 1.9-2.76 1.9-4.53z"/>
        <path fill="#205eff" d="M16.5 12c0-2.49-1.01-4.74-2.64-6.36l-1.06 1.06a8.96 8.96 0 0 1 0 10.6l1.06 1.06C15.49 16.74 16.5 14.49 16.5 12z"/>
      </svg>


      <input id="volume" type="range" min="0" max="1" step="0.01" value="1" style="width:80px; accent-color:#205eff;">
      
      <div class="speed-selector-wrapper">
        <select id="speed" class="speed-selector">
            <option value="0.75">0.75x</option>
            <option value="1" selected>1x</option>
            <option value="1.25">1.25x</option>
            <option value="1.5">1.5x</option>
            <option value="2">2x</option>
        </select>
    </div>

    <button id="close-player" style="
        position: absolute;
        right: 10px;
        top: 10px;
        background: transparent;
        color: white;
        border: none;
        font-size: 15px;
        cursor: pointer;
    ">✕</button>

    </div>
  </div>
  <audio id="audio-element" preload="metadata"></audio>
</div>


<style>

.speed-selector-wrapper {
    margin-right: 10px;
}

@media (max-width: 768px) {
    #persistent-audio-player {
        flex-wrap: wrap;
        padding-right: 60px; /* Ensure enough space for the close button */
    }
    
    /* Fix for mobile controls spacing */
    .audio-controls-container {
        flex: 1 !important;
        justify-content: space-between !important;
        min-width: 250px !important;
        max-width: 100% !important;
    }
}



.podcast-container {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 20px 0;
  color: white;
}

.podcast-label {
  font-weight: bold;
  font-size: 16px;
}

.btn-icon {
    display: inline-block;
    width: 16px;
    height: 16px;
    vertical-align: middle;
    margin-right: 6px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.podcast-play-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
}


.podcast-play-toggle {
  background-color:rgb(255, 255, 255); /* Spotify green */
  border: none;
  color: white;
  font-size: 16px;
  padding: 8px 14px;
  border-radius: 20px;
  cursor: pointer;
}

.podcast-visualizer {
  display: flex;
  margin-left: 10px;
  height: 16px;
  align-items: flex-end;
}

.podcast-visualizer span {
  width: 4px;
  background-color:rgb(253, 253, 253);
  margin: 0 2px;
  animation: bounce 1s infinite ease-in-out;
}

.podcast-visualizer span:nth-child(1) { animation-delay: 0s; }
.podcast-visualizer span:nth-child(2) { animation-delay: 0.2s; }
.podcast-visualizer span:nth-child(3) { animation-delay: 0.4s; }
.podcast-visualizer span:nth-child(4) { animation-delay: 0.6s; }
.podcast-visualizer span:nth-child(5) { animation-delay: 0.8s; }

@keyframes bounce {
  0%, 100% { height: 6px; }
  50% { height: 16px; }
}


.button-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
}



/* Skip Backward Icon */
/* Play icon (triangle) */

.custom-podcast-button-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 20px 0;
    text-align: center;
}

.play-icon {
    width: 0;
    height: 0;
    border-left: 12px solid white;
    border-top: 8px solid transparent;
    border-bottom: 8px solid transparent;
}

/* Pause icon (two bars) */
.pause-icon {
    display: flex;
    gap: 4px;
}
.pause-icon::before,
.pause-icon::after {
    content: '';
    width: 4px;
    height: 16px;
    background-color: white;
    display: inline-block;
}

.circle-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: #343a40;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
}

.speed-selector-wrapper {
  position: relative;
  display: inline-block;
}

/* Custom styled select */
.speed-selector {
  appearance: none;
  -webkit-appearance: none;
  -moz-appearance: none;
  background: transparent;
  border: none;
  color: white;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  padding: 4px;
  outline: none;
}

/* Remove dropdown arrow */
.speed-selector::-ms-expand {
  display: none;
}

/* Transparent dropdown menu (only works well in Firefox + WebKit) */
.speed-selector option {
  background-color: #343a40; /* semi-transparent black */
  color: white;
  padding: 8px;
  font-size: 15px;
  font-weight: 500;
}

/* Optional: highlight on hover (depends on browser) */
.speed-selector option:hover {
  background-color: #205eff;
}

#track-title #module-title {
    font-size: 13px;
    font-weight: normal;
    color: #cccccc;
    display: block;
    margin-top: 4px;
}

#persistent-audio-player {
    transition: left 0.3s ease, width 0.3s ease;
}

</style>
</footer>

{{{ output.standard_end_of_body_html }}}

{{#js}}
require(['theme_moove/persistent_player'], function(PersistentPlayer) {
    PersistentPlayer.init();
});
{{/js}}


{{#js}}
    require(['theme_boost/footer-popover'], function(FooterPopover) {
        FooterPopover.init();
    });
{{/js}}