{{!
    @template theme_moove/drawers

    Moove drawer template.

    Context variables required for this template:
    * sitename - The name of the site
    * output - The core renderer for the page
    * bodyattributes - attributes for the body tag as a string of html attributes
    * sidepreblocks - HTML for the blocks
    * hasblocks - true if there are blocks on this page
    * courseindexopen - true if the nav drawer should be open on page load
    * regionmainsettingsmenu - HTML for the region main settings menu
    * hasregionmainsettingsmenu - There is a region main settings menu on this page.

    Example context (json):
    {
        "sitename": "Moodle",
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Test page",
            "favicon": "favicon.ico",
            "main_content": "<h1>Headings make html validators happier</h1>"
         },
        "bodyattributes":"",
        "sidepreblocks": "<h2>Blocks html goes here</h2>",
        "hasblocks":true,
        "courseindexopen": true,
        "navdraweropen": false,
        "blockdraweropen": true,
        "regionmainsettingsmenu": "",
        "hasregionmainsettingsmenu": false,
        "addblockbutton": ""
    }
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> theme_moove/moove/accessibilitybar }}

{{> core/local/toast/wrapper}}

<div id="page-wrapper" class="d-print-block">

    {{{ output.standard_top_of_body_html }}}

    {{> theme_moove/navbar }}
    {{#courseindex}}
        {{< theme_boost/drawer }}
            {{$id}}theme_boost-drawers-courseindex{{/id}}
            {{$drawerheadercontent}}
                {{> theme_boost/courseindexdrawercontrols}}
            {{/drawerheadercontent}}
            {{$drawerclasses}}drawer drawer-left {{#courseindexopen}}show{{/courseindexopen}}{{/drawerclasses}}
            {{$drawercontent}}
                {{{courseindex}}}
            {{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-index{{/drawerpreferencename}}
            {{$drawerstate}}show-drawer-left{{/drawerstate}}
            {{$tooltipplacement}}right{{/tooltipplacement}}
            {{$closebuttontext}}{{#str}}closecourseindex, core{{/str}}{{/closebuttontext}}
        {{/ theme_boost/drawer}}
    {{/courseindex}}
    {{#hasblocks}}
        {{< theme_boost/drawer }}
            {{$id}}theme_boost-drawers-blocks{{/id}}
            {{$drawerclasses}}drawer drawer-right{{#blockdraweropen}} show{{/blockdraweropen}}{{/drawerclasses}}
            {{$drawercontent}}
                <div class="d-print-none">
                    {{{ addblockbutton }}}
                    {{{ sidepreblocks }}}
                </div>
            {{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-block{{/drawerpreferencename}}
            {{$forceopen}}{{#forceblockdraweropen}}1{{/forceblockdraweropen}}{{/forceopen}}
            {{$drawerstate}}show-drawer-right{{/drawerstate}}
            {{$tooltipplacement}}left{{/tooltipplacement}}
            {{$drawercloseonresize}}1{{/drawercloseonresize}}
            {{$closebuttontext}}{{#str}}closeblockdrawer, core{{/str}}{{/closebuttontext}}
        {{/ theme_boost/drawer}}
    {{/hasblocks}}
    <div id="page" data-region="mainpage" data-usertour="scroller" class="drawers {{#courseindexopen}}show-drawer-left{{/courseindexopen}} {{#blockdraweropen}}show-drawer-right{{/blockdraweropen}} drag-container">

        {{{ output.full_header }}}

        <div id="topofscroll" class="main-inner">
            <div class="drawer-toggles d-flex">
                {{#courseindex}}
                    <div class="drawer-toggler drawer-left-toggle open-nav d-print-none">
                        <button
                            class="btn icon-no-margin"
                            data-toggler="drawers"
                            data-action="toggle"
                            data-target="theme_boost-drawers-courseindex"
                            data-toggle="tooltip"
                            data-placement="right"
                            title="{{#str}}opendrawerindex, core{{/str}}"
                        >
                            <span class="sr-only">{{#str}}opendrawerindex, core{{/str}}</span>
                            {{#pix}} t/index_drawer, moodle {{/pix}}
                        </button>
                    </div>
                {{/courseindex}}
                {{#hasblocks}}
                    <div class="drawer-toggler drawer-right-toggle ms-auto d-print-none">
                        <button
                            class="btn icon-no-margin"
                            data-toggler="drawers"
                            data-action="toggle"
                            data-target="theme_boost-drawers-blocks"
                            data-toggle="tooltip"
                            data-placement="right"
                            title="{{#str}}opendrawerblocks, core{{/str}}"
                        >
                            <span class="sr-only">{{#str}}opendrawerblocks, core{{/str}}</span>
                            <span class="dir-rtl-hide">{{#pix}}t/blocks_drawer, core{{/pix}}</span>
                            <span class="dir-ltr-hide">{{#pix}}t/blocks_drawer_rtl, core{{/pix}}</span>
                        </button>
                    </div>
                {{/hasblocks}}
            </div>

            <div id="page-content" class="pb-3 d-print-block">
                <div id="region-main-box">
                    {{#hasregionmainsettingsmenu}}
                    <div id="region-main-settings-menu" class="d-print-none">
                        <div> {{{ regionmainsettingsmenu }}} </div>
                    </div>
                    {{/hasregionmainsettingsmenu}}
                    <div id="region-main">

                        {{#hasregionmainsettingsmenu}}
                            <div class="region_main_settings_menu_proxy"></div>
                        {{/hasregionmainsettingsmenu}}
                        {{{ output.course_content_header }}}
                        {{#headercontent}}
                            {{> core/activity_header }}
                        {{/headercontent}}
                        {{#overflow}}
                            <div class="container-fluid tertiary-navigation">
                                <div class="navitem">
                                    {{> core/url_select}}
                                </div>
                            </div>
                        {{/overflow}}
                        {{{ output.main_content }}}
                        {{{ output.activity_navigation }}}
                        {{{ output.course_content_footer }}}

                    </div>
                </div>
            </div>
        </div>
    </div>
    {{> theme_moove/footer }}

    {{{ output.standard_after_main_region_html }}}
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader', 'theme_boost/drawer'], function(Loader, Drawer) {
    Drawer.init();
    M.util.js_complete('theme_boost/loader');
});
require([], function() {
    //console.log("✅ Custom JS loaded from drawers.mustache");
    
    function initSectionClickHandler() {
        //console.log("🔄 Initializing section to Module Outline redirect...");
        
        // Find all section title links
        const sectionLinks = document.querySelectorAll(".courseindex-section-title a.courseindex-link");
        //console.log(`📋 Found ${sectionLinks.length} section links`);
        
        if (sectionLinks.length === 0) {
            //console.log("⏳ No section links found, retrying...");
            setTimeout(initSectionClickHandler, 1000);
            return;
        }
        
        sectionLinks.forEach((sectionLink, index) => {
            const sectionTitle = sectionLink.textContent.trim();
            //console.log(`🔗 Setting up redirect for: "${sectionTitle}"`);
            
            sectionLink.addEventListener("click", function(e) {
                handleSectionClick(e, this);
            }, true);
        });
        
        //console.log("✅ All section redirects configured");
    }
    
    function handleSectionClick(e, clickedLink) {
        const sectionTitle = clickedLink.textContent.trim();
        //console.log(`\n🔥 Section clicked: "${sectionTitle}"`);
        
        // Prevent default section navigation
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        
        // Find the section container
        const sectionContainer = clickedLink.closest(".courseindex-section");
        if (!sectionContainer) {
            //console.log("❌ Section container not found");
            return;
        }
        
        // Look for Module Outline in this section
        const moduleOutlineUrl = findModuleOutlineInSection(sectionContainer);
        
        if (moduleOutlineUrl) {
            //console.log(`➡️ Redirecting to Module Outline: ${moduleOutlineUrl}`);
            window.location.href = moduleOutlineUrl;
        } else {
            //console.log("⚠️ Module Outline not found, using original section link");
            window.location.href = clickedLink.href;
        }
    }
    
    function findModuleOutlineInSection(sectionContainer) {
        //console.log("🔍 Looking for Module Outline in section...");
        
        // Strategy 1: Look in courseindex items (Item 2, 3, etc.)
        const courseIndexItems = sectionContainer.querySelectorAll(".courseindex-item");
        //console.log(`📦 Found ${courseIndexItems.length} courseindex items`);
        
        for (let i = 0; i < courseIndexItems.length; i++) {
            const item = courseIndexItems[i];
            const link = item.querySelector("a");
            
            if (link) {
                const text = link.textContent.trim();
                //console.log(`  📌 Item ${i + 1}: "${text}"`);
                
                if (text.toLowerCase().includes("module outline")) {
                    //console.log("🎯 Found Module Outline in courseindex items!");
                    return link.href;
                }
            }
        }
        
        // Strategy 2: Look in list items (LIST ITEMS section from console)
        const listItems = sectionContainer.querySelectorAll("ul li, ol li");
        //console.log(`📋 Found ${listItems.length} list items`);
        
        for (let i = 0; i < listItems.length; i++) {
            const listItem = listItems[i];
            const link = listItem.querySelector("a");
            
            if (link) {
                const text = link.textContent.trim();
                //console.log(`  📝 List ${i + 1}: "${text}"`);
                
                if (text.toLowerCase().includes("module outline")) {
                    //console.log("🎯 Found Module Outline in list items!");
                    return link.href;
                }
            }
        }
        
        // Strategy 3: Search all links for Module Outline
        const allLinks = sectionContainer.querySelectorAll("a");
        //console.log(`🔗 Searching through ${allLinks.length} total links...`);
        
        for (let link of allLinks) {
            const text = link.textContent.trim();
            const href = link.href;
            
            if (text.toLowerCase().includes("module outline") && 
                href && !href.includes("section.php")) {
                //console.log(`🎯 Found Module Outline in general search: "${text}"`);
                return href;
            }
        }
        
        // Strategy 4: Get first activity (fallback)
        //console.log("⚠️ Module Outline not found, looking for first activity...");
        
        // Try courseindex items first
        const firstCourseIndexItem = sectionContainer.querySelector(".courseindex-item a");
        if (firstCourseIndexItem) {
            const text = firstCourseIndexItem.textContent.trim();
            if (!text.toLowerCase().includes("expand")) {
                //console.log(`🔄 Using first courseindex item: "${text}"`);
                return firstCourseIndexItem.href;
            }
        }
        
        // Try list items
        const firstListItem = sectionContainer.querySelector("ul li a, ol li a");
        if (firstListItem) {
            const text = firstListItem.textContent.trim();
            //console.log(`🔄 Using first list item: "${text}"`);
            return firstListItem.href;
        }
        
        //console.log("❌ No suitable activity found");
        return null;
    }
    
    // Initialize when ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSectionClickHandler);
    } else {
        initSectionClickHandler();
    }
    
    // Also retry a few times to catch dynamic content
    setTimeout(initSectionClickHandler, 1000);
    setTimeout(initSectionClickHandler, 2000);
});
{{/js}}
