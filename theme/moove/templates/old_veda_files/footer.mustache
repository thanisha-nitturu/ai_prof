<!-- Script -->
<script>
document.addEventListener('DOMContentLoaded', function () {
  const icon = document.getElementById('chatbot-icon');
  const chatSidebar = document.getElementById('chat-sidebar');
  const closeBtn = document.getElementById('chat-close');
  const fullscreenBtn = document.getElementById('chat-fullscreen');
  const path = window.location.pathname;
  const navbar = document.querySelector('nav.navbar');

  let isFullscreen = false;
  
  if (path.includes('/user/edit.php') && window.location.search.includes('course=1')) {
    if (icon) icon.style.display = 'none';
    if (chatSidebar) chatSidebar.style.display = 'none';
    return; // stop further chatbot init
  }

  // On /my/chat.php page, hide components
  if (path.includes('/my/chat.php')) {
    if (icon) icon.style.display = 'none';
    if (navbar) navbar.style.display = 'none';

    const drawer = document.querySelector('[data-region="drawers"]');
    if (drawer) drawer.style.display = 'none';
    return;
  }

  // Hides chatIocn if user not logged-in , only for devlearn
  if (
  window.location.hostname === "devlearn.hitloop.com" && // domain matches
  window.location.pathname === "/" &&                   // no extra path
  !window.location.search                               // no query string
) {
  if (icon) icon.style.display = 'none';
  if (chatSidebar) chatSidebar.style.display = 'none';
  return;
}

  // To Open chat window on login, storing a localStorage variable.
  let chatWindowOpenOnLogin = localStorage.getItem("chatWindowOpenOnLogin");
  if(!chatWindowOpenOnLogin){
    localStorage.setItem("chatWindowOpenOnLogin", "true");
  }

  // Load previous state from localStorage
  let isOpen = localStorage.getItem('chatSidebarOpen') === 'true';
  if (isOpen){
    icon.style.display = 'none';
    chatSidebar.classList.add('open');
  } else {
    chatSidebar.classList.remove('open');
    icon.style.display = 'flex';
  }


  // Remove no-transition after a short delay to ensure no flicker
  setTimeout(() => {
    chatSidebar.classList.remove('no-transition');
  }, 50);

  // Toggle open/close
  icon?.addEventListener('click', function () {
    isOpen = !isOpen;
    if (isOpen){
      chatSidebar.classList.add('open');
    } else {
      chatSidebar.classList.remove('open');
    }
    icon.style.display = isOpen ? 'none' : 'flex';
    localStorage.setItem('chatSidebarOpen', isOpen);
    localStorage.setItem('chatWindowOpenOnLogin', "false");
  });

  // Close on X
  closeBtn?.addEventListener('click', function () {
    isOpen = false;
    isFullscreen = false;
    chatSidebar.classList.remove('fullscreen-chat');
    chatSidebar.classList.remove('open');
    localStorage.setItem('chatSidebarOpen', isOpen);
    localStorage.setItem('chatWindowOpenOnLogin', "false");
    icon.style.display = 'flex';
  });
  // Fullscreen button
  fullscreenBtn?.addEventListener('click', function () {
    isFullscreen = !isFullscreen;
    if (isFullscreen) {
        chatSidebar.classList.add('fullscreen-chat');
        icon.style.display = 'none'; // Hide chat icon
    } else {
        chatSidebar.classList.remove('fullscreen-chat');
        icon.style.display = 'flex'; // Show chat icon again
    }
 });
});

document.addEventListener('DOMContentLoaded', () => {
    const chatIcon = document.getElementById('chatbot-icon');
    const chatSidebar = document.getElementById('chat-sidebar');
    const player = document.getElementById('persistent-audio-player');

    // Exit if the necessary elements don't exist on the page.
    if (!chatIcon || !player) {
        return;
    }

    // To launch chat window on user login/signup.
    const isLogin = localStorage.getItem("chatWindowOpenOnLogin");
    if (chatIcon && M.cfg.userId > 0 && isLogin === 'true')  {   // means user is logged in
      chatIcon.style.display = 'flex';
      console.log("Icon clicked by function");
      localStorage.setItem("chatWindowOpenOnLogin", "false");
      setTimeout(() => {
        chatIcon.click();
      }, 2000);
      
    }

    // This function now MEASURES the player's height.
    const adjustIconPosition = () => {
        if (player.style.display !== 'none') {
            // Player is visible:
            // 1. Get the player's current height in pixels.
            const playerHeight = player.offsetHeight;

            // 2. Define a small margin (e.g., 15px) for spacing above the player.
            const margin = 15;

            // 3. Set the icon's position to the player's height + margin.
            chatIcon.style.bottom = `${playerHeight + margin}px`;
            chatSidebar.style.bottom = `${playerHeight + margin}px`;
            chatSidebar.style.height = `calc(100% - 70px - ${playerHeight + margin}px - 20px)`;
        } else {
            // Player is hidden: Reset icon to its default low position.
            chatIcon.style.bottom = '20px';
            chatSidebar.style.bottom = '20px';
            chatSidebar.style.height = 'calc(100% - 70px - 20px - 20px)';
        }
    };

    // --- Observers ---

    // 1. Watch for when the player is shown or hidden.
    const observer = new MutationObserver(adjustIconPosition);
    observer.observe(player, {
        attributes: true,
        attributeFilter: ['style']
    });

    // 2. Watch for window resizing, as this can also change the player's height.
    let resizeTimeout;
    window.addEventListener('resize', () => {
        // Debounce the resize event to improve performance.
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(adjustIconPosition, 100);
    });

    // --- Initial Setup ---
    // Run the function once on page load to set the correct initial position.
    adjustIconPosition();
});
</script>

