# ──────────────────────────────────────────────────────────────────
# ENVIRONMENT CONFIGURATION (.env)
# 
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Fill in the real values for the server you are deploying to.
# 3. NEVER commit the real .env file to Git!
# ──────────────────────────────────────────────────────────────────

# The environment name: 'dev', 'staging', or 'prod'
MOODLE_ENV=dev

# Project name used by Docker to prefix containers (e.g. devlearn-moodle, staging-moodle)
COMPOSE_PROJECT_NAME=devlearn-moodle

# Web exposed port for Moodle (e.g. 8084 for dev, 8085 for staging)
MOODLE_PORT=8084

# Web exposed port for Redis
REDIS_PORT=6384

# Absolute path on the host server where moodledata is stored
# Example: /var/www/moodledata (dev) or /var/www/moodledata-staging (staging)
MOODLEDATA_PATH=/var/www/moodledata

# Infisical API endpoint
INFISICAL_API_URL=http://infisical-backend:8080

# Infisical Authentication (Get these from your Infisical Dashboard)
INFISICAL_CLIENT_ID=your-client-id-here
INFISICAL_CLIENT_SECRET=your-client-secret-here
INFISICAL_PROJECT_ID=your-project-id-here
